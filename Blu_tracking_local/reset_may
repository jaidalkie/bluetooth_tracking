ssh-keygen -R 192.168.1.110

rm -f ~/.ssh/authorized_keys
mkdir -p ~/.ssh && chmod 700 ~/.ssh

scp $env:USERPROFILE\.ssh\id_ed25519_new.pub may@192.168.1.110:~/new.pub
ssh may@192.168.1.110 "cat ~/new.pub >> ~/.ssh/authorized_keys && rm ~/new.pub && chmod 600 ~/.ssh/authorized_keys"

ssh -i $env:USERPROFILE\.ssh\id_ed25519_new may@192.168.1.110